#!/usr/bin/env bash
# antigravity-linux: installs/updates/removes Google Antigravity 2.0 and, optionally,
# Antigravity IDE on Linux. Resolves the latest official tarballs from
# https://antigravity.google/download.
#
# One file does everything. Download it from the latest GitHub Release and run
# `sudo bash antigravity-linux install`; it keeps a copy in /usr/local/bin and
# `antigravity-linux update` later replaces that copy with the newest release.
set -euo pipefail

PROJECT_NAME="antigravity-linux"
DOWNLOAD_PAGE="https://antigravity.google/download"
CLI_INSTALLER="https://antigravity.google/cli/install.sh"
INSTALL_DESKTOP=1
INSTALL_IDE=0
INSTALL_CLI=0
INSTALL_NAUTILUS=1
INSTALL_DEPS=1
DO_UNINSTALL=0
DO_STATUS=0
DO_PRINT_DOWNLOADS=0
FORCE=0
USE_CACHE=1
DO_UPDATE=0
PROXY_URL=""

# Install locations. Variables (not literals) so tests can redirect them.
OPT_DIR="/opt"
BIN_DIR="/usr/local/bin"
SHARE_DIR="/usr/share"
HELPER_PATH="$BIN_DIR/antigravity-linux"
VERSION_FILE_NAME=".antigravity-linux-version"

# Stamped with the release tag by .github/workflows/release.yml; "dev" in a checkout.
VERSION="dev"
RELEASES_URL="https://github.com/ongtungduong/antigravity-linux-installer/releases"
# Release tag `update` installs; empty means the latest release. Pin it with
# ANTIGRAVITY_LINUX_REF=v1.2.3 (sudo is told to keep it, see ensure_root).
HELPER_REF="${ANTIGRAVITY_LINUX_REF:-}"
# Latest Google versions, refreshed by .github/workflows/google-versions.yml. Used
# only to skip an update that has nothing to do; it never chooses what is installed.
VERSIONS_URL="https://raw.githubusercontent.com/ongtungduong/antigravity-linux-installer/google-versions/versions.txt"

# Every download gets a connect timeout and a total time limit, so a stalled
# connection cannot hang an install (or the daily CI run) forever.
CURL_COMMON=(-fsSL --retry 3 --connect-timeout 20)

log() { printf '%s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || err "Required command not found: $1"; }

# fetch URL OUTFILE MAX_SECONDS [extra curl args...]
fetch() {
  local url="$1" out="$2" max="$3"
  shift 3
  curl "${CURL_COMMON[@]}" --max-time "$max" "$@" -o "$out" "$url"
}

valid_tag() { [[ "$1" =~ ^v[0-9][A-Za-z0-9._-]*$ ]]; }

# The /releases/latest page redirects to /releases/tag/<tag>: no API token or rate limit.
latest_release_tag() {
  local url tag
  url=$(curl "${CURL_COMMON[@]}" --max-time 60 -o /dev/null -w '%{url_effective}' "$RELEASES_URL/latest") \
    || err "Could not look up the latest release of $PROJECT_NAME."
  tag="${url##*/}"
  valid_tag "$tag" || err "Unexpected release URL: $url"
  printf '%s\n' "$tag"
}

target_release_tag() {
  if [ -z "$HELPER_REF" ]; then
    latest_release_tag
  else
    valid_tag "$HELPER_REF" || err "Invalid ANTIGRAVITY_LINUX_REF: '$HELPER_REF' (use a release tag such as v1.0.0)."
    printf '%s\n' "$HELPER_REF"
  fi
}

# verify_checksum FILE NAME SUMS_FILE: NAME must be listed in SUMS_FILE and match.
verify_checksum() {
  local expected actual
  expected=$(awk -v n="$2" '$2 == n || $2 == "*" n {print $1; exit}' "$3")
  [ -n "$expected" ] || return 1
  actual=$(sha256sum "$1" | awk '{print $1}')
  [ "$expected" = "$actual" ]
}

# Files written by root must be readable by everybody: sudo keeps a stricter
# caller umask (e.g. 077), which would leave /opt and the .desktop files unreadable.
init_environment() { umask 022; }

usage() {
  cat <<'USAGE'
antigravity-linux: Google Antigravity installer for Linux

Usage:
  antigravity-linux install [options]    Install (or reinstall) the apps
  antigravity-linux update [options]     Fetch the latest release of this script, then install/update
  antigravity-linux --status
  antigravity-linux --print-downloads
  antigravity-linux --uninstall

Default:
  Installs or updates Antigravity 2.0 desktop app system-wide.

Options:
  --desktop              Install/update Antigravity 2.0 desktop app only (default)
  --ide                  Install/update Antigravity IDE only
  --all                  Install/update Antigravity 2.0 desktop app + Antigravity IDE
  --cli                  Also run Google's official Antigravity CLI installer
  --no-nautilus          Skip GNOME Files/Nautilus context-menu helper
  --no-apt               Do not install apt dependencies automatically
  --force                Reinstall even when the recorded version matches
  --no-cache             On update, ask Google directly instead of the published version list
  --proxy URL            Route all downloads through this HTTP(S) proxy
  --status               Show installed helper-managed apps and versions
  --print-downloads      Print the resolved official Google tarball URLs
  --version              Print the version of this script
  --uninstall            Remove helper-managed Antigravity desktop/IDE files
  -h, --help             Show this help
USAGE
}

# System-wide changes need root. sudo drops the environment (sudo-rs has no -E),
# so pass the proxy settings explicitly.
ensure_root() {
  [ "$(id -u)" -ne 0 ] || return 0
  local a
  for a in "$@"; do
    case "$a" in --status|--print-downloads|--version|-h|--help) return 0 ;; esac
  done
  [ -f "${BASH_SOURCE[0]:-}" ] || err "Root is needed, but this script was piped in. Save it to a file and run it from there."
  command -v sudo >/dev/null 2>&1 || { echo "ERROR: This needs root, and sudo was not found. Run it as root." >&2; exit 1; }
  exec sudo env "http_proxy=${http_proxy:-${HTTP_PROXY:-}}" "https_proxy=${https_proxy:-${HTTPS_PROXY:-}}" \
    "no_proxy=${no_proxy:-${NO_PROXY:-}}" "ANTIGRAVITY_LINUX_REF=${ANTIGRAVITY_LINUX_REF:-}" \
    bash "${BASH_SOURCE[0]}" "$@"
}

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      install) ;;
      update) DO_UPDATE=1 ;;
      --desktop) INSTALL_DESKTOP=1; INSTALL_IDE=0 ;;
      --ide) INSTALL_DESKTOP=0; INSTALL_IDE=1 ;;
      --all) INSTALL_DESKTOP=1; INSTALL_IDE=1 ;;
      --cli) INSTALL_CLI=1 ;;
      --no-nautilus) INSTALL_NAUTILUS=0 ;;
      --no-apt) INSTALL_DEPS=0 ;;
      --force) FORCE=1 ;;
      --no-cache) USE_CACHE=0 ;;
      --proxy)
        shift
        [ $# -gt 0 ] || err "--proxy needs a URL"
        PROXY_URL="$1"
        ;;
      --status) DO_STATUS=1 ;;
      --print-downloads) DO_PRINT_DOWNLOADS=1 ;;
      --version) printf 'antigravity-linux %s\n' "$VERSION"; exit 0 ;;
      --uninstall) DO_UNINSTALL=1 ;;
      -h|--help) usage; exit 0 ;;
      *) err "Unknown option: $1" ;;
    esac
    shift
  done
}

# Proxy: an explicit --proxy wins; otherwise fill in whichever of the
# upper/lower-case variables is missing (an empty lowercase value can shadow
# the uppercase one, and sudo may only pass one of them through).
setup_proxy() {
  if [ -n "$PROXY_URL" ]; then
    http_proxy="$PROXY_URL"; https_proxy="$PROXY_URL"
  else
    http_proxy="${http_proxy:-${HTTP_PROXY:-}}"
    https_proxy="${https_proxy:-${HTTPS_PROXY:-${http_proxy:-}}}"
  fi
  if [ -n "$https_proxy" ] || [ -n "$http_proxy" ]; then
    HTTP_PROXY="$http_proxy"; HTTPS_PROXY="$https_proxy"
    no_proxy="${no_proxy:-${NO_PROXY:-}}"; NO_PROXY="$no_proxy"
    export http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY
    case "$http_proxy$https_proxy" in
      *@*) warn "Proxy credentials are visible to other local users in the process list while the installer runs." ;;
    esac
  fi
}

detect_platform() {
  if [ "$(uname -s)" != "Linux" ]; then
    err "This installer is for Linux only."
  fi
  case "$(uname -m)" in
    x86_64|amd64) AG_PLATFORM="linux-x64"; DESKTOP_TOP="Antigravity-x64" ;;
    aarch64|arm64) AG_PLATFORM="linux-arm"; DESKTOP_TOP="Antigravity-arm64" ;;
    *) err "Unsupported CPU architecture: $(uname -m). Google currently provides x64 and ARM64 Linux builds." ;;
  esac
}

pkg_installed() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q '^install ok installed'; }

install_deps_debian() {
  [ "$INSTALL_DEPS" -eq 1 ] || return 0
  if command -v apt-get >/dev/null 2>&1; then
    local packages=(ca-certificates curl tar python3 desktop-file-utils xdg-utils) missing=() p
    if [ "$INSTALL_NAUTILUS" -eq 1 ] && [ "$INSTALL_IDE" -eq 1 ]; then
      packages+=(python3-nautilus)
    fi
    for p in "${packages[@]}"; do
      pkg_installed "$p" || missing+=("$p")
    done
    # Nothing missing: skip apt entirely (no network, and an unrelated broken repo cannot block an update).
    [ "${#missing[@]}" -gt 0 ] || return 0
    export DEBIAN_FRONTEND=noninteractive
    apt-get update || warn "apt-get update failed; trying to install anyway."
    apt-get install -y "${missing[@]}"
  else
    for c in curl tar python3; do need "$c"; done
  fi
}

fetch_download_page() {
  local tmpdir="$1"
  local html="$tmpdir/download.html"
  # The download page embeds the tarball URLs directly in its HTML.
  fetch "$DOWNLOAD_PAGE" "$html" 60 --compressed \
    || err "Could not download $DOWNLOAD_PAGE. Check your network/DNS (try: getent hosts antigravity.google)."
  printf '%s\n' "$html"
}

resolve_download() {
  local page="$1"
  local product="$2"
  python3 - "$page" "$AG_PLATFORM" "$product" <<'PY'
import html, re, sys
from pathlib import Path
from urllib.parse import unquote
text = html.unescape(Path(sys.argv[1]).read_text(errors='replace'))
platform = sys.argv[2]
product = sys.argv[3]

def fail(msg):
    raise SystemExit(msg)

def version_from_url(url):
    decoded = unquote(url)
    # Known current layouts include antigravity-hub/<version>/ and stable/<version>/.
    for pattern in (r'/antigravity-hub/([^/]+)/', r'/stable/([^/]+)/', r'/(\d+\.\d+\.\d+(?:-[^/]+)?)/'):
        m = re.search(pattern, decoded)
        if m:
            return m.group(1)
    return 'unknown'

if product == 'desktop':
    marker = 'id="antigravity-2"'
    next_marker = 'id="antigravity-cli"'
    filename_patterns = [r'Antigravity\.tar\.gz']
    label = 'Antigravity 2.0'
elif product == 'ide':
    marker = 'id="antigravity-ide"'
    next_marker = 'id="antigravity-sdk"'
    filename_patterns = [r'Antigravity%20IDE\.tar\.gz', r'Antigravity\+IDE\.tar\.gz', r'Antigravity IDE\.tar\.gz']
    label = 'Antigravity IDE'
else:
    fail(f'Unknown product: {product}')

sections = []
start = text.find(marker)
if start != -1:
    end = text.find(next_marker, start)
    sections.append(text[start:end if end != -1 else None])
sections.append(text)

for section in sections:
    for filename_re in filename_patterns:
        # HTTPS only, and only Google-owned download hosts.
        pattern = r'https://(?:[\w-]+\.)*(?:googleapis\.com|gvt1\.com|google\.com|googleusercontent\.com)/[^"\'\s<>)]*/' + re.escape(platform) + r'/' + filename_re
        matches = re.findall(pattern, section)
        if matches:
            url = matches[-1]
            print(version_from_url(url), url)
            sys.exit(0)

fail(f'Could not find official {label} tarball for {platform} on the Google download page')
PY
}

resolve_desktop_download() { resolve_download "$1" desktop; }
resolve_ide_download() { resolve_download "$1" ide; }

asar_extract_icon_png() {
  local asar="$1"
  local out="$2"
  python3 - "$asar" "$out" <<'PY'
import json, struct, sys
from pathlib import Path
asar = Path(sys.argv[1])
out = Path(sys.argv[2])
with asar.open('rb') as f:
    f.read(4)
    header_size = struct.unpack('<I', f.read(4))[0]
    f.read(4)
    json_size = struct.unpack('<I', f.read(4))[0]
    header = json.loads(f.read(json_size).decode())
icon = header.get('files', {}).get('icon.png')
if not icon:
    raise SystemExit('icon.png not found in app.asar')
with asar.open('rb') as f:
    f.seek(8 + header_size + int(icon['offset']))
    out.write_bytes(f.read(int(icon['size'])))
PY
}

# Swap NEWDIR into TARGET. Refuses to touch a directory this helper did not create,
# and restores the old install if the final move fails.
safe_replace_dir() {
  local newdir="$1"
  local target="$2"
  if [ -d "$target" ] && [ ! -f "$target/$VERSION_FILE_NAME" ]; then
    err "$target exists but was not installed by $PROJECT_NAME. Move it away and run again."
  fi
  rm -rf "${target}.previous"
  if [ -d "$target" ]; then
    mv "$target" "${target}.previous"
  fi
  if ! mv "$newdir" "$target"; then
    if [ -d "${target}.previous" ]; then mv "${target}.previous" "$target"; fi
    err "Could not move the new install into $target; the previous version was restored."
  fi
  rm -rf "${target}.previous"
}

extract_tarball() {
  # --no-same-owner: as root, tar would otherwise keep the archive's uid/gid.
  tar --no-same-owner -xzf "$1" -C "$2"
}

ensure_launcher_free() {
  if [ -e "$1" ] && [ ! -L "$1" ]; then
    err "$1 exists and is not a symlink; refusing to overwrite it."
  fi
}

fix_chrome_sandbox() {
  local sandbox="$1"
  if [ -f "$sandbox" ]; then
    chown root:root "$sandbox"
    chmod 4755 "$sandbox"
  fi
}

refresh_desktop_caches() {
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$SHARE_DIR/applications" >/dev/null 2>&1 || true
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q "$SHARE_DIR/icons/hicolor" >/dev/null 2>&1 || true
  fi
}

installed_version() {
  local file="$1"
  cat "$file" 2>/dev/null || true
}

# is_up_to_date BINARY VERSION VERSION_FILE: skip the install only when the
# recorded version is known and equal. "unknown" can never be compared, so it
# always reinstalls instead of freezing the install on a layout we cannot parse.
is_up_to_date() {
  [ "$FORCE" -eq 0 ] && [ -x "$1" ] || return 1
  [ -n "$2" ] && [ "$2" != "unknown" ] || return 1
  [ "$(installed_version "$3")" = "$2" ]
}

# up_to_date_per_cache: true when every selected app is already at the version in
# the published list. One small download instead of apt and Google's page. Any
# doubt (list unreachable, product missing, --force/--no-cache/--cli) returns false
# and the normal path, which asks Google directly, runs.
up_to_date_per_cache() {
  [ "$FORCE" -eq 0 ] && [ "$USE_CACHE" -eq 1 ] && [ "$INSTALL_CLI" -eq 0 ] || return 1
  local list pending=0 v
  list=$(mktemp "${TMPDIR:-/var/tmp}/$PROJECT_NAME.XXXXXX") || return 1
  if ! fetch "$VERSIONS_URL" "$list" 15 --retry 0 2>/dev/null; then
    rm -f "$list"; return 1
  fi
  if [ "$INSTALL_DESKTOP" -eq 1 ]; then
    v=$(cached_version "$list" desktop)
    is_up_to_date "$OPT_DIR/antigravity/$DESKTOP_TOP/antigravity" "$v" "$OPT_DIR/antigravity/$VERSION_FILE_NAME" || pending=1
  fi
  if [ "$INSTALL_IDE" -eq 1 ]; then
    v=$(cached_version "$list" ide)
    is_up_to_date "$OPT_DIR/antigravity-ide/Antigravity-IDE/antigravity-ide" "$v" "$OPT_DIR/antigravity-ide/$VERSION_FILE_NAME" || pending=1
  fi
  rm -f "$list"
  return "$pending"
}

cached_version() { awk -v p="$2" -v a="$AG_PLATFORM" '$1 == p && $2 == a {print $3; exit}' "$1"; }

install_desktop_app() {
  local tmpdir="$1"
  local page="$2"
  local version url
  read -r version url < <(resolve_desktop_download "$page")
  local root="$OPT_DIR/antigravity"
  local target="$root/$DESKTOP_TOP/antigravity"
  local version_file="$root/$VERSION_FILE_NAME"
  if is_up_to_date "$target" "$version" "$version_file"; then
    log "Antigravity 2.0 $version is already installed."
    return
  fi
  [ "$version" != "unknown" ] || warn "Could not read the Antigravity 2.0 version from the download URL; installing anyway."
  ensure_launcher_free "$BIN_DIR/antigravity"

  log "Downloading Antigravity 2.0 $version for $AG_PLATFORM from Google..."
  local archive="$tmpdir/Antigravity.tar.gz"
  fetch "$url" "$archive" 1800
  local top_dir="$DESKTOP_TOP" extract="$tmpdir/desktop"
  mkdir -p "$extract"
  extract_tarball "$archive" "$extract"
  [ -x "$extract/$top_dir/antigravity" ] || err "Unexpected Antigravity archive layout: $top_dir/antigravity not found."

  local icon_staged="$tmpdir/antigravity.png"
  if [ -f "$extract/$top_dir/resources/app.asar" ]; then
    asar_extract_icon_png "$extract/$top_dir/resources/app.asar" "$icon_staged" || warn "Could not extract desktop icon; continuing."
  fi

  rm -rf "${root}.new"
  mkdir -p "${root}.new"
  mv "$extract/$top_dir" "${root}.new/"
  printf '%s\n' "$version" > "${root}.new/$VERSION_FILE_NAME"
  printf '%s\n' "$url" > "${root}.new/.antigravity-linux-source-url"
  fix_chrome_sandbox "${root}.new/$top_dir/chrome-sandbox"
  safe_replace_dir "${root}.new" "$root"

  ln -sfn "$root/$top_dir/antigravity" "$BIN_DIR/antigravity"
  mkdir -p "$SHARE_DIR/icons/hicolor/512x512/apps" "$SHARE_DIR/applications"
  if [ -f "$icon_staged" ]; then
    install -m 0644 "$icon_staged" "$SHARE_DIR/icons/hicolor/512x512/apps/antigravity.png"
  fi
  cat > "$SHARE_DIR/applications/antigravity.desktop" <<DESKTOP
[Desktop Entry]
Name=Antigravity
Comment=Google Antigravity 2.0 agent platform
Exec=$BIN_DIR/antigravity %U
Icon=antigravity
Terminal=false
Type=Application
Categories=Development;IDE;
StartupNotify=true
StartupWMClass=Antigravity
DESKTOP
  refresh_desktop_caches
  log "Installed Antigravity 2.0 $version at $root/$top_dir"
}

install_ide_app() {
  local tmpdir="$1"
  local page="$2"
  local version url
  read -r version url < <(resolve_ide_download "$page")
  local root="$OPT_DIR/antigravity-ide"
  local install_dir="Antigravity-IDE"
  local version_file="$root/$VERSION_FILE_NAME"
  if is_up_to_date "$root/$install_dir/antigravity-ide" "$version" "$version_file"; then
    log "Antigravity IDE $version is already installed."
    return
  fi
  [ "$version" != "unknown" ] || warn "Could not read the Antigravity IDE version from the download URL; installing anyway."
  ensure_launcher_free "$BIN_DIR/antigravity-ide"

  log "Downloading Antigravity IDE $version for $AG_PLATFORM from Google..."
  local archive="$tmpdir/Antigravity-IDE.tar.gz"
  fetch "$url" "$archive" 1800
  local top_dir="Antigravity IDE" extract="$tmpdir/ide"
  mkdir -p "$extract"
  extract_tarball "$archive" "$extract"
  [ -x "$extract/$top_dir/antigravity-ide" ] || err "Unexpected Antigravity IDE archive layout: $top_dir/antigravity-ide not found."

  rm -rf "${root}.new"
  mkdir -p "${root}.new"
  mv "$extract/$top_dir" "${root}.new/$install_dir"
  printf '%s\n' "$version" > "${root}.new/$VERSION_FILE_NAME"
  printf '%s\n' "$url" > "${root}.new/.antigravity-linux-source-url"
  fix_chrome_sandbox "${root}.new/$install_dir/chrome-sandbox"
  safe_replace_dir "${root}.new" "$root"

  ln -sfn "$root/$install_dir/antigravity-ide" "$BIN_DIR/antigravity-ide"
  mkdir -p "$SHARE_DIR/icons/hicolor/512x512/apps" "$SHARE_DIR/applications"
  local icon_source="$root/$install_dir/resources/app/resources/linux/code.png"
  if [ -f "$icon_source" ]; then
    install -m 0644 "$icon_source" "$SHARE_DIR/icons/hicolor/512x512/apps/antigravity-ide.png"
  fi
  cat > "$SHARE_DIR/applications/antigravity-ide.desktop" <<DESKTOP
[Desktop Entry]
Name=Antigravity IDE
Comment=Google Antigravity IDE
Exec=$BIN_DIR/antigravity-ide %F
Icon=antigravity-ide
Terminal=false
Type=Application
Categories=Development;IDE;
MimeType=inode/directory;text/plain;application/x-code-workspace;application/x-antigravity-workspace;x-scheme-handler/antigravity-ide;
StartupNotify=true
StartupWMClass=antigravity-ide
DESKTOP
  refresh_desktop_caches
  log "Installed Antigravity IDE $version at $root/$install_dir"
}

install_nautilus_extension() {
  [ "$INSTALL_NAUTILUS" -eq 1 ] || return 0
  [ "$INSTALL_IDE" -eq 1 ] || return 0
  if ! command -v nautilus >/dev/null 2>&1; then
    return 0
  fi
  if ! python3 - <<'PY' >/dev/null 2>&1
try:
    import gi
    gi.require_version('Nautilus', '4.0')
except Exception:
    raise SystemExit(1)
PY
  then
    warn "Skipping Nautilus extension because Python Nautilus bindings are unavailable."
    return 0
  fi
  mkdir -p "$SHARE_DIR/nautilus-python/extensions"
  cat > "$SHARE_DIR/nautilus-python/extensions/open-in-antigravity-ide.py" <<'PY'
import subprocess
from urllib.parse import unquote, urlparse
from gi.repository import Nautilus, GObject

class OpenInAntigravityIDE(GObject.GObject, Nautilus.MenuProvider):
    def _path(self, file_info):
        uri = file_info.get_uri()
        parsed = urlparse(uri)
        if parsed.scheme != 'file':
            return None
        return unquote(parsed.path)

    def get_file_items(self, files):
        if not files or len(files) != 1:
            return []
        path = self._path(files[0])
        if not path:
            return []
        item = Nautilus.MenuItem(
            name='OpenInAntigravityIDE::open',
            label='Open in Antigravity IDE',
            tip='Open this folder or file in Antigravity IDE'
        )
        item.connect('activate', lambda _item: subprocess.Popen(['antigravity-ide', path]))
        return [item]

    def get_background_items(self, folder):
        path = self._path(folder)
        if not path:
            return []
        item = Nautilus.MenuItem(
            name='OpenInAntigravityIDE::open_background',
            label='Open Folder in Antigravity IDE',
            tip='Open the current folder in Antigravity IDE'
        )
        item.connect('activate', lambda _item: subprocess.Popen(['antigravity-ide', path]))
        return [item]
PY
  log "Installed Nautilus context-menu helper. Restart Files/Nautilus to see it."
}

install_helper() {
  # Make sure this script is the installed helper (also when run from a checkout).
  local self
  self=$(readlink -f "${BASH_SOURCE[0]:-}" 2>/dev/null || true)
  [ -f "$self" ] || err "Cannot install the helper from a piped script. Save the script to a file and run it from there."
  if [ "$self" != "$(readlink -f "$HELPER_PATH" 2>/dev/null || true)" ]; then
    install -m 0755 "$self" "$HELPER_PATH.new"
    mv -f "$HELPER_PATH.new" "$HELPER_PATH"
  fi
  # Shortcuts only for what is being installed, so `update-antigravity` never installs an app nobody asked for.
  if [ "$INSTALL_DESKTOP" -eq 1 ]; then write_update_wrapper update-antigravity --desktop; fi
  if [ "$INSTALL_IDE" -eq 1 ]; then write_update_wrapper update-antigravity-ide --ide; fi
}

write_update_wrapper() {
  local name="$1" flag="$2"
  printf '#!/usr/bin/env bash\nexec "%s" update %s "$@"\n' "$HELPER_PATH" "$flag" > "$BIN_DIR/$name"
  chmod 0755 "$BIN_DIR/$name"
}

# Replace this script with the newest (or pinned) release, but only after its
# SHA256SUMS entry matches and it parses as shell. Returns when already current.
self_update() {
  need curl; need sha256sum
  local tag tmp base args=() a
  tag=$(target_release_tag)
  if [ "$tag" = "$VERSION" ]; then
    log "$PROJECT_NAME $VERSION is already the latest."
    return 0
  fi
  log "Updating $PROJECT_NAME $VERSION -> $tag..."
  base="$RELEASES_URL/download/$tag"
  tmp=$(mktemp -d "${TMPDIR:-/var/tmp}/$PROJECT_NAME.XXXXXX")
  fetch "$base/antigravity-linux" "$tmp/antigravity-linux" 60 || { rm -rf "$tmp"; err "Could not download $base/antigravity-linux"; }
  fetch "$base/SHA256SUMS" "$tmp/SHA256SUMS" 60 || { rm -rf "$tmp"; err "Could not download $base/SHA256SUMS"; }
  verify_checksum "$tmp/antigravity-linux" antigravity-linux "$tmp/SHA256SUMS" || { rm -rf "$tmp"; err "Checksum mismatch for release $tag; refusing to update."; }
  bash -n "$tmp/antigravity-linux" || { rm -rf "$tmp"; err "Downloaded script is not valid shell; aborting update."; }
  install -m 0755 "$tmp/antigravity-linux" "$HELPER_PATH.new"
  mv -f "$HELPER_PATH.new" "$HELPER_PATH"
  rm -rf "$tmp"
  for a in "${ORIGINAL_ARGS[@]}"; do [ "$a" = "update" ] || args+=("$a"); done
  run_updated_helper "${args[@]}"
}

# The new copy takes over from here (a seam so tests can stop before the exec).
run_updated_helper() { exec "$HELPER_PATH" install "$@"; }

install_cli() {
  local cli_curl="curl -fsSL --retry 3 --connect-timeout 20 --max-time 300"
  if [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER:-}" != "root" ]; then
    log "Running Google's official Antigravity CLI installer as $SUDO_USER..."
    # sudo resets the environment, so hand the proxy to the user's shell explicitly.
    local env_args=()
    [ -z "${http_proxy:-}" ] || env_args+=("http_proxy=$http_proxy")
    [ -z "${https_proxy:-}" ] || env_args+=("https_proxy=$https_proxy")
    sudo -u "$SUDO_USER" -H env "${env_args[@]}" bash -lc "$cli_curl '$CLI_INSTALLER' | bash"
  else
    log "Running Google's official Antigravity CLI installer as root (no sudo user to drop to)..."
    # shellcheck disable=SC2086  # cli_curl is a fixed, space-separated option string
    $cli_curl "$CLI_INSTALLER" | bash
  fi
}

print_status() {
  log "Antigravity Linux status"
  if [ -x "$BIN_DIR/antigravity" ]; then
    log "- Antigravity 2.0: installed ($(installed_version "$OPT_DIR/antigravity/$VERSION_FILE_NAME"))"
    log "  Command: $BIN_DIR/antigravity"
  else
    log "- Antigravity 2.0: not installed by this helper"
  fi
  if [ -x "$BIN_DIR/antigravity-ide" ]; then
    log "- Antigravity IDE: installed ($(installed_version "$OPT_DIR/antigravity-ide/$VERSION_FILE_NAME"))"
    log "  Command: $BIN_DIR/antigravity-ide"
  else
    log "- Antigravity IDE: not installed by this helper"
  fi
  if [ -x "$HELPER_PATH" ]; then
    log "- Update helper: installed"
  else
    log "- Update helper: not installed"
  fi
}

print_downloads() {
  need curl
  need python3
  local tmp_parent="${TMPDIR:-/tmp}"
  local tmpdir
  tmpdir=$(mktemp -d "$tmp_parent/$PROJECT_NAME.XXXXXX")
  # shellcheck disable=SC2064  # expand now on purpose: $tmpdir is local and gone when the trap fires
  trap "rm -rf '$tmpdir'" EXIT
  local page
  page=$(fetch_download_page "$tmpdir")
  if [ "$INSTALL_DESKTOP" -eq 1 ]; then
    local version url
    read -r version url < <(resolve_desktop_download "$page")
    log "Antigravity 2.0 $version: $url"
  fi
  if [ "$INSTALL_IDE" -eq 1 ]; then
    local version url
    read -r version url < <(resolve_ide_download "$page")
    log "Antigravity IDE $version: $url"
  fi
}

print_success_summary() {
  log ""
  log "Antigravity Linux install complete."
  log ""
  log "Installed:"
  if [ "$INSTALL_DESKTOP" -eq 1 ]; then
    log "- Antigravity 2.0: $BIN_DIR/antigravity"
  fi
  if [ "$INSTALL_IDE" -eq 1 ]; then
    log "- Antigravity IDE: $BIN_DIR/antigravity-ide"
  fi
  log ""
  log "Manage:"
  log "- Status:    antigravity-linux --status"
  log "- Update:    antigravity-linux update --all"
  log "- Uninstall: antigravity-linux --uninstall"
  if [ "$INSTALL_IDE" -eq 1 ]; then
    log ""
    log "Folder open integration: use your file manager's Open With menu, or Nautilus context menu after restarting Files."
  fi
}

uninstall_all() {
  local d f
  # Only remove /opt directories this helper created (they carry its version file).
  for d in antigravity antigravity-ide; do
    if [ ! -e "$OPT_DIR/$d" ] || [ -f "$OPT_DIR/$d/$VERSION_FILE_NAME" ]; then
      rm -rf "${OPT_DIR:?}/$d" "${OPT_DIR:?}/$d.new" "${OPT_DIR:?}/$d.previous"
    else
      warn "$OPT_DIR/$d was not installed by $PROJECT_NAME; leaving it in place."
    fi
  done
  for f in antigravity antigravity-ide; do
    if [ -L "$BIN_DIR/$f" ]; then rm -f "$BIN_DIR/$f"; fi
  done
  rm -f "$BIN_DIR/update-antigravity" "$BIN_DIR/update-antigravity-ide" "$BIN_DIR/antigravity-linux"
  rm -f "$SHARE_DIR/applications/antigravity.desktop" "$SHARE_DIR/applications/antigravity-ide.desktop"
  rm -f "$SHARE_DIR/icons/hicolor/512x512/apps/antigravity.png" "$SHARE_DIR/icons/hicolor/512x512/apps/antigravity-ide.png"
  rm -f "$SHARE_DIR/nautilus-python/extensions/open-in-antigravity-ide.py"
  refresh_desktop_caches
  log "Removed helper-managed Antigravity files. User settings under home directories were left untouched."
}

main() {
  ORIGINAL_ARGS=("$@")
  ensure_root "$@"
  init_environment
  parse_args "$@"
  setup_proxy
  detect_platform
  if [ "$DO_STATUS" -eq 1 ]; then
    print_status
    exit 0
  fi
  if [ "$DO_PRINT_DOWNLOADS" -eq 1 ]; then
    print_downloads
    exit 0
  fi
  if [ "$DO_UNINSTALL" -eq 1 ]; then
    uninstall_all
    exit 0
  fi

  [ "$DO_UPDATE" -eq 0 ] || self_update
  if [ "$DO_UPDATE" -eq 1 ] && up_to_date_per_cache; then
    log "Everything is already up to date."
    exit 0
  fi
  install_deps_debian
  local tmp_parent="${TMPDIR:-/var/tmp}"
  mkdir -p "$tmp_parent"
  local tmpdir
  tmpdir=$(mktemp -d "$tmp_parent/$PROJECT_NAME.XXXXXX")
  # shellcheck disable=SC2064  # expand now on purpose: $tmpdir is local and gone when the trap fires
  trap "rm -rf '$tmpdir'" EXIT
  local page
  page=$(fetch_download_page "$tmpdir")
  [ "$INSTALL_DESKTOP" -eq 1 ] && install_desktop_app "$tmpdir" "$page"
  [ "$INSTALL_IDE" -eq 1 ] && install_ide_app "$tmpdir" "$page"
  install_nautilus_extension
  install_helper
  if [ "$INSTALL_CLI" -eq 1 ]; then
    install_cli || warn "Antigravity CLI installer failed; the desktop/IDE install is complete."
  fi
  print_success_summary
}

# Run only when executed, so tests can source this file and call its functions.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  main "$@"
fi
